
#include <Wire.h>
#include <SparkFun_TMP117.h>

TMP117 sensor;

void setup() {
  Serial.begin(115200);
  delay(1000);

  // SDA = D2, SCL = D1
  Wire.begin(D2, D1);

  if (!sensor.begin()) {
    Serial.println("TMP117 not detected!");
    while (1) {
      delay(100);
    }
  }

  Serial.println("TMP117 ready!");
}

void loop() {
  if (sensor.dataReady()) {
    float tempC = sensor.readTempC();

    // Send temperature to Processing
    Serial.println(tempC, 2);
  }

  delay(200);
}

